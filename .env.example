PORT=3000

# Local dev on host (PostgreSQL & Redis exposed by root docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379

# Standalone container (docker compose up inside modules/katz-todo)
DOCKER_DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/app
DOCKER_REDIS_URL=redis://host.docker.internal:6379

# Bot Tokens (optional)
TELEGRAM_TOKEN=your_telegram_bot_token_here
DISCORD_TOKEN=your_discord_bot_token_here
